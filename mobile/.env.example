# Copy to .env and fill in. Public values only: never put a secret or service role key here.
# Supabase dashboard > Project Settings > API Keys. Use the publishable key (sb_publishable_...).
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# RevenueCat > Project settings > API keys > public app-specific key for the App Store app (appl_...).
# Public by design (it ships inside the app). Never the secret key (sk_...).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
