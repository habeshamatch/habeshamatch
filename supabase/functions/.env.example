# Copy to supabase/functions/.env for `supabase functions serve` (git ignores the copy).
# On the live project these are set with `supabase secrets set` (never committed).
REVENUECAT_WEBHOOK_AUTH=Bearer local-test-secret
REVENUECAT_SECRET_KEY=sk_your_revenuecat_v1_secret_key
# Same value as the Vault secret 'push_function_secret' (see migration 20261102000000).
PUSH_FUNCTION_SECRET=local-push-secret
