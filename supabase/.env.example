# Local Supabase only. Copy to supabase/.env (git ignores it).
# Placeholders are fine locally: only the test_otp numbers in config.toml are used, and they never send an SMS.
# Never put real Twilio credentials here; enter them in the Supabase dashboard for the remote project.
SUPABASE_AUTH_SMS_TWILIO_ACCOUNT_SID=AC_local_placeholder
SUPABASE_AUTH_SMS_TWILIO_MESSAGE_SERVICE_SID=MG_local_placeholder
SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=local_placeholder
